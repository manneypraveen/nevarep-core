# NEVAREP Configuration

# Claude API (for LLM processing)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# FRED API (for US yields data) — get free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Database
DB_TYPE=duckdb
DB_PATH=data/nevarep.duckdb

# NSE Settings
NSE_MAX_ERRORS=5
NSE_SESSION_REFRESH_WAIT=10
NSE_REQUEST_DELAY=1.5

# Data directories
BHAV_DIR=data/raw_csv/fo_bhav
CM_BHAV_DIR=data/raw_csv/cm_bhav
PARTICIPANT_OI_DIR=data/raw_csv/participant_oi
ARTICLES_DIR=data/articles

# Historical date range
HIST_START=2022-01-03
HIST_END=2025-03-21
